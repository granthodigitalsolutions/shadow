{
  "name": "team-shadow-kai-backend",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/admin/batches",
      "destination": "/api/admin/payments?kind=batch"
    },
    {
      "source": "/api/examiner/:action(allocate|remove-student|start-exam|recover|capacity)",
      "destination": "/api/examiner/session?action=:action"
    }
  ]
}
