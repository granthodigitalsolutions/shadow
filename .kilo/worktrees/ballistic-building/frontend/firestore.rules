rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStudentRegistrationEnabled(programType) {
      let docId = programType == 'KARATE' ? 'systemSettings_KARATE' : (programType == 'SELAMBAM' ? 'systemSettings_SELAMBAM' : 'systemSettings');
      let settings = get(/databases/$(database)/documents/settings/$(docId));
      return settings == null || settings.data.studentRegistrationEnabled != false;
    }

    function isReferee() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/referees/$(request.auth.uid));
    }

    function isSecretary() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/secretaries/$(request.auth.uid));
    }

    // Auth Access Control Settings
    function getAuthSettings() {
      return get(/databases/$(database)/documents/auth_settings/global).data;
    }

    function isSecretaryRegistrationOpen() {
      return getAuthSettings().roles.secretary.registration.enabled == true;
    }

    // Null-safe: if auth_settings/global has not been seeded yet, referee
    // registration is open — this matches the client default and stops a
    // missing config doc from silently blocking self-registration.
    function isRefereeRegistrationOpen() {
      let settings = get(/databases/$(database)/documents/auth_settings/global);
      return settings == null || settings.data.roles.referee.registration.enabled != false;
    }
    // Note: isStudent() is intentionally omitted — student doc IDs are custom (STU_xxx),
    // not Firebase Auth UIDs. Ownership is checked via resource.data.uid == request.auth.uid.

    // Isolate Program Updates
    // Safe for legacy docs that may not have programType field
    function isProgramIsolated() {
      return (
        !('programType' in resource.data) ||
        (
          'programType' in request.resource.data &&
          request.resource.data.programType == resource.data.programType
        )
      );
    }

    // Soft Delete Check (handles legacy docs without isDeleted field)
    function isNotDeleted() {
      return resource == null || !('isDeleted' in resource.data) || resource.data.isDeleted != true;
    }

    // Public visibility (for unauthenticated registration dropdowns)
    function isPublicVisible() {
      return true; // Allow collection reads without isDeleted filter
    }

    // Admin Permissions (Full Access)
    match /auditLogs/{logId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.performedBy == request.auth.uid);
    }
    match /system/cacheVersion {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
    
    // Auth Access Control
    match /auth_settings/{docId} {
      allow read: if true; // Publicly readable to enforce login checks
      allow write: if isAdmin();
    }
    match /auth_settings_history/{docId} {
      allow read, write: if isAdmin();
    }
    // No bootstrap rule. First admin must be created via Firebase Console.
    match /admins/{adminId} {
      allow read: if isAdmin() || request.auth.uid == adminId;
      allow write: if isAdmin() || request.auth.uid == adminId;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /programs/{programId} {
      allow read: if isPublicVisible();
      allow write: if isAdmin();
    }
    match /branches/{branchId} {
      allow read: if isPublicVisible();
      allow write: if isAdmin();
    }

    // Secretary Permissions
    match /secretaries/{secretaryId} {
      allow read: if isAdmin() || isSecretary() || request.auth.uid == secretaryId;
      allow create: if isAuthenticated() && request.auth.uid == secretaryId;
      allow update, delete: if isAdmin();
    }

    match /secretaryRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() && isSecretaryRegistrationOpen();
    }

    // Links a Secretary to the Schools they manage (many-to-many)
    match /secretarySchools/{linkId} {
      allow read:   if isAdmin() || (isSecretary() && resource.data.secretaryId == request.auth.uid);
      allow create: if isAdmin() || (isSecretary() && request.resource.data.secretaryId == request.auth.uid);
      allow delete: if isAdmin() || (isSecretary() && resource.data.secretaryId == request.auth.uid);
    }

    match /schoolFeeRequests/{requestId} {
      allow read: if isAdmin() || isSecretary();
      allow create: if isSecretary() && request.resource.data.secretaryId == request.auth.uid;
      allow update: if isAdmin() || (isSecretary() && resource.data.secretaryId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // LEGACY: referee signup no longer creates approval requests. These docs are
    // kept read-only so accounts from the old approval flow can migrate
    // themselves into /referees on their next login — which means the owner
    // must be able to read their own request.
    match /refereeRequests/{requestId} {
      allow read: if isAdmin() || request.auth.uid == requestId;
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // Referee Permissions
    match /referees/{refereeId} {
      allow read: if isAdmin() || isReferee() || request.auth.uid == refereeId;

      // Admins can create referees. Referees self-register with no admin
      // approval — active immediately — while registration is open. A holder of
      // a legacy refereeRequests doc may always migrate itself, since that
      // account already exists and must not be locked out by the toggle.
      allow create: if isAdmin() || (isAuthenticated() &&
                    request.auth.uid == refereeId &&
                    request.resource.data.uid == request.auth.uid &&
                    (isRefereeRegistrationOpen() ||
                     exists(/databases/$(database)/documents/refereeRequests/$(request.auth.uid))));

      allow update: if isAdmin() || 
                    (isSecretary() && isNotDeleted() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'assignedBatchIds', 'updatedAt'
                     ])
                    ) ||
                    (isReferee() && request.auth.uid == refereeId && isProgramIsolated() && isNotDeleted() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'updatedAt', 'lastLogin', 'deviceInfo'
                     ])
                    );
      allow delete: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      // Public Registration with strict field whitelist + data validation
      allow create: if isAdmin() || (
        isSecretary() &&
        request.resource.data.secretaryId == request.auth.uid &&
        request.resource.data.paymentStatus == 'pending'
      ) || (
        isStudentRegistrationEnabled(request.resource.data.programType) &&
        request.resource.data.keys().hasOnly([
          'id', 'uid', 'name', 'gender', 'registrationType', 'schoolId', 'school', 'standard', 
          'contact', 'whatsapp', 'beltLevel', 'beltIndex', 'stageLevel', 'beltTestId', 'batchId', 'refereeId',
          'paymentStatus', 'testStatus', 'programType', 'program', 'programId', 'branchId', 
          'paymentDetails', 'paymentMethod', 'paymentReference', 'paymentAmount',
          'originalType', 'transferredFrom', 'transferredAt', 'registeredAt', 'updatedAt',
          'secretaryId', 'pdfStatus', 'deliveryStatus', 'receiptUrl',
          'locationName', 'locationText', 'locationAddress', 'latitude', 'longitude', 'qrUrl', 'registrationWhatsappStatus', 'qrWhatsappStatus'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.programType in ['KARATE', 'SELAMBAM'] &&
        (!('uid' in request.resource.data) || request.resource.data.uid == null) &&
        (!('paymentAmount' in request.resource.data) || (
          request.resource.data.paymentAmount is number &&
          request.resource.data.paymentAmount >= 0
        )) &&
        // contact is optional but if present must be a valid phone string
        (!('contact' in request.resource.data) || 
          request.resource.data.contact == '' ||
          (request.resource.data.contact is string &&
           request.resource.data.contact.size() >= 10 &&
           request.resource.data.contact.size() <= 16)
        ) &&
        // whatsapp is required
        request.resource.data.whatsapp is string &&
        request.resource.data.whatsapp.size() >= 10 &&
        request.resource.data.whatsapp.size() <= 16 &&
        // Enforce server-managed timestamps to prevent client-side injection
        request.resource.data.registeredAt == request.time &&
        request.resource.data.updatedAt == request.time
      );
        
      allow read: if isAdmin() || isReferee() || isSecretary() || 
                  (isNotDeleted() && isAuthenticated() && resource.data.uid == request.auth.uid);
      // Referee can only update their specific scoring fields
      allow update: if isAdmin() || 
                    (isNotDeleted() && isSecretary() && resource.data.secretaryId == request.auth.uid && isProgramIsolated() &&
                     // NOTE: paymentStatus/paymentMethod/paymentReference/paymentDetails are intentionally
                     // excluded — only Admin may confirm/activate a student (see isAdmin() branch above).
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'pdfStatus', 'deliveryStatus', 'receiptUrl', 'updatedAt', 'program',
                       'name', 'gender', 'standard', 'contact', 'whatsapp', 'schoolId', 'school', 'beltLevel', 'beltIndex', 'stageLevel', 'programType'
                     ])
                    ) ||
                    (isNotDeleted() && isSecretary() && isProgramIsolated() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'batchId', 'refereeId', 'updatedAt', 'program'
                     ])
                    ) ||
                    (isNotDeleted() && isReferee() && resource.data.refereeId == request.auth.uid && isProgramIsolated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'score', 'percentage', 'result', 'grade', 'rank', 'ranking', 'technicalScore', 'athleticScore', 'totalScore',
                       'testStatus', 'scoringResults', 'subCategoryResults', 'testDate', 'examinerRemarks', 
                       'lastScoreUpdatedAt', 'scoredAt', 'resultFinalized', 'resultLocked', 'updatedAt', 'program',
                       'resultPdfUrl', 'resultPdfPath', 'pdfUploaded', 'uploadedAt', 'storageFolder', 'completedAt', 'updatedBy'
                     ])
                    ) ||
                    (isNotDeleted() && isReferee() && isProgramIsolated() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'batchId', 'refereeId', 'scannedAt', 'updatedAt',
                       'schoolId', 'school', 'registrationType', 'originalType', 'transferredFrom', 'transferredAt', 'program'
                     ])
                    );
      allow delete: if isAdmin() || (isSecretary() && resource.data.secretaryId == request.auth.uid);
    }

    // Batches
    match /batches/{batchId} {
      allow read: if isAdmin() || isReferee() || isSecretary();
      allow create, delete: if isAdmin() || isSecretary();
      allow update: if isAdmin() || isSecretary() || 
                    (isNotDeleted() && isReferee() && request.auth.uid in resource.data.refereeIds && isProgramIsolated() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'studentIds', 'status', 'completedCount', 'updatedAt', 'program', 'startedAt', 'completedAt'
                     ])
                    );
                    
      // Delivery Campaigns subcollection
      match /campaigns/{campaignId} {
        allow read, write: if isAdmin();
      }
    }

    // Public Reads for Registration Flow
    match /schools/{schoolId} {
      allow read: if isPublicVisible();
      allow create: if isAdmin() || (isSecretary() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() || (
        isSecretary() && resource.data.createdBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'branch', 'contactPerson', 'contactNumber', 'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /beltTests/{testId} {
      allow read: if isPublicVisible();
      allow create, update, delete: if isAdmin();
    }

    match /feeStructure/{feeId} {
      allow read: if isPublicVisible();
      allow create, update, delete: if isAdmin();
    }

    match /silambanFees/{feeId} {
      allow read: if isPublicVisible();
      allow create, update, delete: if isAdmin();
    }
  }
}
